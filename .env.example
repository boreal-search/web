# Copy to `.env` for `bun run dev` / `bun run preview`.
# In production these are Vercel project env vars (dashboard, or `bun x vercel env add <NAME>`).
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
ENGINE_URL=http://localhost:8000
ENGINE_SERVICE_TOKEN=dev-token-change-me
# Optional: app emails via Resend (src/lib/server/email.ts). Unset = sending throws.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Boreal Search <support@borealsearch.app>
# HMAC key for permanent /pages and /pdf links; same value as the engine's FILE_SIGNING_KEY.
FILE_SIGNING_KEY=<64 hex chars, from the workstation .env>

# Test logins for scripts/shots.ts (password accounts on the linked project; never commit).
# Pick one per run with SHOTS_AS=platform-admin|org-admin|member (default org-admin).
TEST_PLATFORM_ADMIN_EMAIL=
TEST_PLATFORM_ADMIN_PASSWORD=
TEST_ORG_ADMIN_EMAIL=
TEST_ORG_ADMIN_PASSWORD=
# The member login is the one Claude may read and type into a browser; keep it a throwaway account.
TEST_CLAUDE_READABLE_MEMBER_EMAIL=
TEST_CLAUDE_READABLE_MEMBER_PASSWORD=

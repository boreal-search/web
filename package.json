{
	"name": "boreal-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "bun x vercel deploy --prod",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"gen:engine-client": "sh scripts/gen-engine-client.sh",
		"gen:supabase-types": "supabase gen types typescript --linked > src/lib/supabase/types.ts",
		"shots": "bun scripts/shots.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"openapi-typescript": "^7.13.0",
		"playwright-core": "^1.64.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/schibsted-grotesk": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.1",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.118.0",
		"@vercel/functions": "^3.10.4",
		"mdast-util-from-markdown": "^2.1.0",
		"paneforge": "^1.0.2"
	}
}
